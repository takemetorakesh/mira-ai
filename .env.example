# Postgres (local demo credentials). Tests/evals use the same credentials with database mira_eval.
DATABASE_URL=postgresql+asyncpg://rakesh:pass1234@localhost:5432/mira

# LLM provider: opencode_go | openai | openai_compatible (needs LLM_BASE_URL)
LLM_PROVIDER=opencode_go
LLM_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
# LLM_BASE_URL=

# "Today" for resolving relative dates. Pinned so the demo and evals line up with the seeded data
# (e.g. the villa sold out "this weekend"). Remove it to use the real date in Asia/Kolkata.
MIRA_TODAY=2026-10-06

HOLD_TTL_MINUTES=15
